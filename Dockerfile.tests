FROM python:3.11-slim

WORKDIR /app

# Layer 1: System dependencies (cache first, internet fallback)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client gcc python3-dev libpq-dev netcat-openbsd

# Layer 2: Python dependencies (persistent pip cache first, index fallback)
COPY requirements.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install -r requirements.txt

# Layer 3: Application code (changes frequently)
# This layer will rebuild when your code changes
COPY . /app/
RUN chmod +x /app/run_tests.sh

# Layer 4: Environment variables (rarely change)
ENV PYTHONPATH=/app:$PYTHONPATH \
    DJANGO_SETTINGS_MODULE=config.test_settings \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TESTING=1 \
    WEB3_ENABLED=0

CMD ["bash", "/app/run_tests.sh"]
